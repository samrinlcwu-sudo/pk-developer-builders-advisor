<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', {
  title: 'Insights',
  description: "Real estate, investment, and construction insights from PK Developer Builders & Advisor.",
  canonicalPath: '/insights'
}) %>
</head>
<body>
<%- include('../partials/nav', { active: 'insights' }) %>

<main id="main-content">

<section class="page-hero">
  <div class="breadcrumb"><a href="/index.html">Home</a> / Insights</div>
  <h1>Insights</h1>
  <p>Real estate, investment, and construction perspective from our team.</p>
</section>

<section class="section fade-in">
  <div class="container">

    <div class="insights-categories">
      <a href="/insights" class="category-pill <%= !query.category ? 'active' : '' %>">All</a>
      <% categories.forEach(function(c) { %>
        <a href="/insights?category=<%= c %>" class="category-pill <%= query.category === c ? 'active' : '' %>"><%= c.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ') %></a>
      <% }) %>
    </div>

    <% if (featured) { %>
      <a href="/insights/<%= featured.slug %>" class="article-card article-card--featured" style="display:grid;">
        <div class="img-placeholder">
          <% if (featured.cover_image_path) { %>
            <img src="<%= featured.cover_image_path %>" alt="<%= featured.title %>" style="width:100%; height:100%; object-fit:cover;" />
          <% } else { %>
            <%- crBlock('Featured article photo') %>
          <% } %>
        </div>
        <div class="article-card-body">
          <span class="project-tag">Featured</span>
          <h3><%= featured.title %></h3>
          <p style="color:var(--color-gray);"><%- cr(featured.excerpt, 'Article summary') %></p>
          <div class="article-card-meta"><%- cr(featured.published_at, 'Publish date') %><% if (featured.author_name) { %> &middot; <%= featured.author_name %><% } %></div>
        </div>
      </a>
    <% } %>

    <% if (articles.length === 0) { %>
      <div class="content-required-block" style="margin-top:32px;">No articles match those filters yet.</div>
    <% } else { %>
      <div class="grid-3" style="margin-top:<%= featured ? '40px' : '0' %>;">
        <% articles.forEach(function(a) { %>
          <a href="/insights/<%= a.slug %>" class="article-card">
            <div class="img-placeholder">
              <% if (a.cover_image_path) { %>
                <img src="<%= a.cover_image_path %>" alt="<%= a.title %>" style="width:100%; height:100%; object-fit:cover;" />
              <% } else { %>
                <%- crBlock('Photo') %>
              <% } %>
            </div>
            <div class="article-card-body">
              <span class="project-tag"><%= a.category %></span>
              <h3><%= a.title %></h3>
              <div class="article-card-meta"><%- cr(a.published_at, 'Date') %></div>
            </div>
          </a>
        <% }) %>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <div class="property-search-actions" style="margin-top:32px; gap:12px;">
          <% for (let i = 1; i <= pagination.totalPages; i++) {
            const params = new URLSearchParams(query);
            params.set('page', i);
          %>
            <a href="/insights?<%= params.toString() %>" class="btn <%= i === pagination.page ? 'btn-primary' : 'btn-outline-navy' %>" style="padding:8px 16px; font-size:0.85rem;"><%= i %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</section>

<section class="cta-band fade-in">
  <div class="container">
    <h2>Have a question about a property decision?</h2>
    <p>Our team is happy to talk it through — no obligation.</p>
    <a href="/contact.html" class="btn btn-primary">Book a Consultation</a>
  </div>
</section>

</main>

<%- include('../partials/footer') %>
</body>
</html>
