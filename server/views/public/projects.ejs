<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', {
  title: 'Projects',
  description: "Explore property development and construction projects delivered by PK Developer Builders & Advisor.",
  canonicalPath: '/projects'
}) %>
</head>
<body>
<%- include('../partials/nav', { active: 'projects' }) %>

<main id="main-content">

<section class="page-hero">
  <div class="breadcrumb"><a href="/index.html">Home</a> / Projects</div>
  <h1>Our Projects</h1>
  <p>A portfolio of development and construction work — real projects, real outcomes.</p>
</section>

<section class="section fade-in">
  <div class="container">

    <form class="property-search-bar" id="project-search-form" method="get" action="/projects">
      <div class="property-search-grid">
        <div class="form-group" style="margin-bottom:0;">
          <label for="filter-status">Status</label>
          <select id="filter-status" name="status">
            <option value="">Any Status</option>
            <% statuses.forEach(function(s) { %>
              <option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group" style="margin-bottom:0;">
          <label for="filter-location">Location</label>
          <select id="filter-location" name="location">
            <option value="">Any Location</option>
            <% locations.forEach(function(l) { %>
              <option value="<%= l.slug %>" <%= query.location === l.slug ? 'selected' : '' %>><%= l.name %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="property-search-actions">
        <button type="submit" class="btn btn-primary">Search Projects</button>
      </div>
    </form>

    <% if (projects.length === 0) { %>
      <div id="project-no-results" class="content-required-block" style="margin-bottom:32px;">No projects match those filters yet.</div>
    <% } else { %>
      <div class="grid-3">
        <% projects.forEach(function(p) { %>
          <div class="project-card">
            <div class="img-placeholder">
              <% if (p.images && p.images.length) { %>
                <img src="<%= p.images[0].file_path %>" alt="<%= p.title %>" style="width:100%; height:100%; object-fit:cover;" />
              <% } else { %>
                <%- crBlock('Project photo') %>
              <% } %>
            </div>
            <div class="project-card-body">
              <span class="project-tag"><%- cr(p.property_type, 'Category') %></span>
              <h3><%= p.title %></h3>
              <p><%- cr(p.location_name, 'Location') %></p>
              <a href="/projects/<%= p.slug %>" class="btn btn-outline-navy" style="margin-top:16px; padding:10px 22px; font-size:0.85rem;">Explore Project</a>
            </div>
          </div>
        <% }) %>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <div class="property-search-actions" style="margin-top:32px; gap:12px;">
          <% for (let i = 1; i <= pagination.totalPages; i++) {
            const params = new URLSearchParams(query);
            params.set('page', i);
          %>
            <a href="/projects?<%= params.toString() %>" class="btn <%= i === pagination.page ? 'btn-primary' : 'btn-outline-navy' %>" style="padding:8px 16px; font-size:0.85rem;"><%= i %></a>
          <% } %>
        </div>
      <% } %>
    <% } %>
  </div>
</section>

<section class="cta-band fade-in">
  <div class="container">
    <h2>Have a site or project in mind?</h2>
    <p>Let's talk through what's possible.</p>
    <a href="/contact.html" class="btn btn-primary">Schedule a Consultation</a>
  </div>
</section>

</main>

<%- include('../partials/footer') %>
</body>
</html>
