<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', {
  title: article.title,
  description: article.excerpt || `${article.title} — an insight from PK Developer Builders & Advisor.`,
  canonicalPath: `/insights/${article.slug}`
}) %>
<%
  const articleLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    mainEntityOfPage: absoluteUrl(`/insights/${article.slug}`),
    publisher: { "@type": "Organization", name: "PK Developer Builders & Advisor", url: absoluteUrl("/") },
  };
  if (article.excerpt) articleLd.description = article.excerpt;
  if (article.cover_image_path) articleLd.image = absoluteUrl(article.cover_image_path);
  if (article.published_at) articleLd.datePublished = article.published_at;
  if (article.author_name) articleLd.author = { "@type": "Person", name: article.author_name };
%>
<%- jsonLd(articleLd) %>
</head>
<body>
<%- include('../partials/nav', { active: 'insights' }) %>

<main id="main-content">

<section class="page-hero">
  <div class="breadcrumb"><a href="/index.html">Home</a> / <a href="/insights">Insights</a> / <%= article.title %></div>
  <span class="project-tag" style="margin-bottom:16px;"><%= article.category %></span>
  <h1><%= article.title %></h1>
  <p><%- cr(article.published_at, 'Publish date') %><% if (article.author_name) { %> &middot; <%= article.author_name %><% } %></p>
</section>

<section class="section fade-in">
  <div class="container">
    <% if (article.cover_image_path) { %>
      <div class="img-placeholder" style="max-width:720px; margin:0 auto 48px; min-height:340px;">
        <img src="<%= article.cover_image_path %>" alt="<%= article.title %>" style="width:100%; height:100%; object-fit:cover;" />
      </div>
    <% } %>

    <div class="article-body" style="max-width:720px; margin:0 auto;">
      <% if (article.body) { %>
        <% article.body.split(/\n{2,}/).forEach(function(paragraph) { %>
          <p><%= paragraph %></p>
        <% }) %>
      <% } else { %>
        <%- crBlock('Article body') %>
      <% } %>
    </div>
  </div>
</section>

<% if (related.length) { %>
<section class="section section-alt fade-in">
  <div class="container">
    <div class="section-header center">
      <span class="eyebrow">Related</span>
      <h2>More Insights</h2>
    </div>
    <div class="grid-3">
      <% related.forEach(function(r) { %>
        <a href="/insights/<%= r.slug %>" class="article-card">
          <div class="img-placeholder">
            <% if (r.cover_image_path) { %>
              <img src="<%= r.cover_image_path %>" alt="<%= r.title %>" style="width:100%; height:100%; object-fit:cover;" />
            <% } else { %>
              <%- crBlock('Photo') %>
            <% } %>
          </div>
          <div class="article-card-body">
            <span class="project-tag"><%= r.category %></span>
            <h3><%= r.title %></h3>
            <div class="article-card-meta"><%- cr(r.published_at, 'Date') %></div>
          </div>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="cta-band fade-in">
  <div class="container">
    <h2>Have a question about a property decision?</h2>
    <p>Our team is happy to talk it through — no obligation.</p>
    <a href="/contact.html" class="btn btn-primary">Book a Consultation</a>
  </div>
</section>

</main>

<%- include('../partials/footer') %>
</body>
</html>
