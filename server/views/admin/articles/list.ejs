<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Articles' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'articles' }) %>

  <div class="admin-page-header">
    <h1>Articles</h1>
    <a href="/admin/articles/new" class="btn btn-primary">+ Add Article</a>
  </div>

  <% if (articles.length === 0) { %>
    <div class="content-required-block">No articles yet. Add the first one to get started.</div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Featured</th>
          <th>Published</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% articles.forEach(function(a) { %>
          <tr>
            <td><%= a.title %></td>
            <td><%= a.category %></td>
            <td><%= a.is_featured ? 'Yes' : 'No' %></td>
            <td><span class="admin-badge admin-badge--<%= a.is_published ? 'live' : 'draft' %>"><%= a.is_published ? 'Published' : 'Draft' %></span></td>
            <td class="admin-table-actions">
              <a href="/admin/articles/<%= a.id %>/edit">Edit</a>
              <form method="post" action="/admin/articles/<%= a.id %>/delete" onsubmit="return confirm('Delete this article permanently?');" style="display:inline;">
                <button type="submit" class="admin-link-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/shell-close') %>
</body>
</html>
