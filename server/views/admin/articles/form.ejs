<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: article ? 'Edit Article' : 'New Article' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'articles' }) %>

  <div class="admin-page-header">
    <h1><%= article ? 'Edit Article' : 'New Article' %></h1>
    <a href="/admin/articles">&larr; Back to Articles</a>
  </div>

  <% if (errors && errors.length) { %>
    <div class="admin-alert admin-alert--error">
      <ul style="margin:0; padding-left:20px;">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="post" action="<%= article ? `/admin/articles/${article.id}` : '/admin/articles' %>" enctype="multipart/form-data" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" required value="<%= article ? article.title : '' %>" />
      </div>
      <div class="form-group">
        <label for="slug">Slug (leave blank to auto-generate from title)</label>
        <input type="text" id="slug" name="slug" value="<%= article ? article.slug : '' %>" placeholder="auto-generated" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="category">Category *</label>
        <select id="category" name="category" required>
          <option value="">Select a category</option>
          <% categories.forEach(function(c) { %>
            <option value="<%= c %>" <%= article && article.category === c ? 'selected' : '' %>><%= c %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="authorName">Author</label>
        <input type="text" id="authorName" name="authorName" value="<%= article && article.author_name ? article.author_name : '' %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="publishedAt">Publish Date</label>
      <input type="date" id="publishedAt" name="publishedAt" value="<%= article && article.published_at ? article.published_at : '' %>" />
    </div>

    <div class="form-group">
      <label for="excerpt">Excerpt / Summary</label>
      <textarea id="excerpt" name="excerpt" rows="2"><%= article ? article.excerpt || '' : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="body">Body</label>
      <textarea id="body" name="body" rows="10"><%= article ? article.body || '' : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="coverImage">Cover Photo</label>
      <input type="file" id="coverImage" name="coverImage" accept="image/jpeg,image/png,image/webp" />
      <% if (article && article.cover_image_path) { %>
        <div class="admin-image-grid" style="margin-top:12px;">
          <div class="admin-image-card"><img src="<%= article.cover_image_path %>" alt="" /></div>
        </div>
      <% } %>
    </div>

    <div class="form-group admin-checkbox-row">
      <input type="checkbox" id="isFeatured" name="isFeatured" <%= article && article.is_featured ? 'checked' : '' %> />
      <label for="isFeatured" style="margin:0;">Featured (shown as the highlighted article on the Insights page)</label>
    </div>

    <div class="form-group admin-checkbox-row">
      <input type="checkbox" id="isPublished" name="isPublished" <%= article && article.is_published ? 'checked' : '' %> />
      <label for="isPublished" style="margin:0;">Published (visible on the public site)</label>
    </div>
    <p style="color:var(--color-gray); font-size:0.85rem; margin-top:-8px;">Requires a title, category, body text, and a cover photo.</p>

    <button type="submit" class="btn btn-primary"><%= article ? 'Save Changes' : 'Create Article' %></button>
  </form>

<%- include('../partials/shell-close') %>
</body>
</html>
