<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: agent ? 'Edit Agent' : 'New Agent' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'agents' }) %>

  <div class="admin-page-header">
    <h1><%= agent ? 'Edit Agent' : 'New Agent' %></h1>
    <a href="/admin/agents">&larr; Back to Agents</a>
  </div>

  <% if (errors && errors.length) { %>
    <div class="admin-alert admin-alert--error">
      <ul style="margin:0; padding-left:20px;">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="post" action="<%= agent ? `/admin/agents/${agent.id}` : '/admin/agents' %>" enctype="multipart/form-data" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" required value="<%= agent ? agent.name : '' %>" />
      </div>
      <div class="form-group">
        <label for="roleTitle">Role / Title</label>
        <input type="text" id="roleTitle" name="roleTitle" value="<%= agent && agent.role_title ? agent.role_title : '' %>" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="phone">Phone</label>
        <input type="text" id="phone" name="phone" value="<%= agent && agent.phone ? agent.phone : '' %>" />
      </div>
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= agent && agent.email ? agent.email : '' %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="photo">Photo (optional)</label>
      <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" />
      <% if (agent && agent.photo_path) { %>
        <div class="admin-image-grid" style="margin-top:12px;">
          <div class="admin-image-card"><img src="<%= agent.photo_path %>" alt="" /></div>
        </div>
      <% } %>
    </div>

    <div class="form-group admin-checkbox-row">
      <input type="checkbox" id="isPublished" name="isPublished" <%= agent && agent.is_published ? 'checked' : '' %> />
      <label for="isPublished" style="margin:0;">Published (visible on the public site)</label>
    </div>

    <button type="submit" class="btn btn-primary"><%= agent ? 'Save Changes' : 'Create Agent' %></button>
  </form>

<%- include('../partials/shell-close') %>
</body>
</html>
