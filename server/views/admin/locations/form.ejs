<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: location ? 'Edit Location' : 'New Location' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'locations' }) %>

  <div class="admin-page-header">
    <h1><%= location ? 'Edit Location' : 'New Location' %></h1>
    <a href="/admin/locations">&larr; Back to Locations</a>
  </div>

  <% if (errors && errors.length) { %>
    <div class="admin-alert admin-alert--error">
      <ul style="margin:0; padding-left:20px;">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="post" action="<%= location ? `/admin/locations/${location.id}` : '/admin/locations' %>" enctype="multipart/form-data" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" required value="<%= location ? location.name : '' %>" />
      </div>
      <div class="form-group">
        <label for="slug">Slug (leave blank to auto-generate from name)</label>
        <input type="text" id="slug" name="slug" value="<%= location ? location.slug : '' %>" placeholder="auto-generated" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="city">City</label>
        <input type="text" id="city" name="city" value="<%= location && location.city ? location.city : '' %>" />
      </div>
      <div class="form-group">
        <label for="region">Region</label>
        <input type="text" id="region" name="region" value="<%= location && location.region ? location.region : '' %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"><%= location ? location.description || '' : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="image">Location photo (optional)</label>
      <input type="file" id="image" name="image" accept="image/jpeg,image/png,image/webp" />
      <% if (location && location.image_path) { %>
        <div class="admin-image-grid" style="margin-top:12px;">
          <div class="admin-image-card"><img src="<%= location.image_path %>" alt="" /></div>
        </div>
      <% } %>
    </div>

    <div class="form-group admin-checkbox-row">
      <input type="checkbox" id="isPublished" name="isPublished" <%= location && location.is_published ? 'checked' : '' %> />
      <label for="isPublished" style="margin:0;">Published (visible on the public site)</label>
    </div>

    <button type="submit" class="btn btn-primary"><%= location ? 'Save Changes' : 'Create Location' %></button>
  </form>

<%- include('../partials/shell-close') %>
</body>
</html>
