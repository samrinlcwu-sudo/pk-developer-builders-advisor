<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Testimonials' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'testimonials' }) %>

  <div class="admin-page-header">
    <h1>Testimonials</h1>
    <a href="/admin/testimonials/new" class="btn btn-primary">+ Add Testimonial</a>
  </div>

  <% if (testimonials.length === 0) { %>
    <div class="content-required-block">No testimonials yet. Add the first one to get started.</div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Author</th>
          <th>Quote</th>
          <th>Verified</th>
          <th>Published</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% testimonials.forEach(function(t) { %>
          <tr>
            <td><%= t.author_name %></td>
            <td><%= t.quote.length > 60 ? t.quote.slice(0, 60) + '…' : t.quote %></td>
            <td><%= t.is_verified ? 'Yes' : 'No' %></td>
            <td><span class="admin-badge admin-badge--<%= t.is_published ? 'live' : 'draft' %>"><%= t.is_published ? 'Published' : 'Draft' %></span></td>
            <td class="admin-table-actions">
              <a href="/admin/testimonials/<%= t.id %>/edit">Edit</a>
              <form method="post" action="/admin/testimonials/<%= t.id %>/delete" onsubmit="return confirm('Delete this testimonial permanently?');" style="display:inline;">
                <button type="submit" class="admin-link-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/shell-close') %>
</body>
</html>
