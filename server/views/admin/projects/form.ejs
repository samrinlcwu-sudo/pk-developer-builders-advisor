<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: project ? 'Edit Project' : 'New Project' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'projects' }) %>

  <div class="admin-page-header">
    <h1><%= project ? 'Edit Project' : 'New Project' %></h1>
    <a href="/admin/projects">&larr; Back to Projects</a>
  </div>

  <% if (errors && errors.length) { %>
    <div class="admin-alert admin-alert--error">
      <ul style="margin:0; padding-left:20px;">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="post" action="<%= project ? `/admin/projects/${project.id}` : '/admin/projects' %>" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" required value="<%= project ? project.title : '' %>" />
      </div>
      <div class="form-group">
        <label for="slug">Slug (leave blank to auto-generate from title)</label>
        <input type="text" id="slug" name="slug" value="<%= project ? project.slug : '' %>" placeholder="auto-generated" />
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>" <%= project && project.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="locationId">Location</label>
        <select id="locationId" name="locationId">
          <option value="">No location selected</option>
          <% locations.forEach(function(l) { %>
            <option value="<%= l.id %>" <%= project && project.location_id === l.id ? 'selected' : '' %>><%= l.name %></option>
          <% }) %>
        </select>
      </div>
    </div>

    <div class="form-group">
      <label for="propertyType">Property Type (e.g. residential, commercial, mixed-use)</label>
      <input type="text" id="propertyType" name="propertyType" value="<%= project && project.property_type ? project.property_type : '' %>" />
    </div>

    <div class="form-group">
      <label for="overview">Overview / Concept & Vision</label>
      <textarea id="overview" name="overview" rows="4"><%= project ? project.overview || '' : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="featuresText">Key Features (one per line)</label>
      <textarea id="featuresText" name="featuresText" rows="4"><%= project && project.features ? project.features.map(f => f.label).join('\n') : '' %></textarea>
    </div>

    <% if (project) { %>
      <div class="form-group">
        <label style="margin-bottom:8px; display:block;">Verified Features <span style="font-weight:400; color:var(--color-gray);">(leave blank until verified)</span></label>
        <% verifiedFeatureCategories.forEach(function(category) {
          const row = project.verifiedFeatures.find(function(v) { return v.category === category; });
        %>
          <div class="form-group">
            <label for="verified_<%= category %>" style="text-transform:capitalize;"><%= category %></label>
            <input type="text" id="verified_<%= category %>" name="verified_<%= category %>" value="<%= row && row.value ? row.value : '' %>" />
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="form-group admin-checkbox-row">
      <input type="checkbox" id="isPublished" name="isPublished" <%= project && project.is_published ? 'checked' : '' %> />
      <label for="isPublished" style="margin:0;">Published (visible on the public site)</label>
    </div>
    <p style="color:var(--color-gray); font-size:0.85rem; margin-top:-8px;">Requires a title, location, and at least one image.</p>

    <button type="submit" class="btn btn-primary"><%= project ? 'Save Changes' : 'Create Project' %></button>
  </form>

  <% if (project) { %>
    <div class="admin-section">
      <h2>Photos</h2>
      <% if (project.images && project.images.length) { %>
        <div class="admin-image-grid">
          <% project.images.forEach(function(img) { %>
            <div class="admin-image-card">
              <img src="<%= img.file_path %>" alt="" />
              <form method="post" action="/admin/projects/<%= project.id %>/images/<%= img.id %>/delete" onsubmit="return confirm('Remove this photo?');">
                <button type="submit" class="admin-link-btn">Remove</button>
              </form>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="content-required-block">No photos uploaded yet — a project needs at least one before it can be published.</div>
      <% } %>
      <form method="post" action="/admin/projects/<%= project.id %>/images" enctype="multipart/form-data" class="admin-upload-form">
        <input type="file" name="images" accept="image/jpeg,image/png,image/webp" multiple required />
        <button type="submit" class="btn btn-outline-navy">Upload Photo(s)</button>
      </form>
    </div>
  <% } %>

<%- include('../partials/shell-close') %>
</body>
</html>
