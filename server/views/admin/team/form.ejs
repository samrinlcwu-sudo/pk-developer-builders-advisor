<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: member ? 'Edit Team Member' : 'New Team Member' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'team' }) %>

  <div class="admin-page-header">
    <h1><%= member ? 'Edit Team Member' : 'New Team Member' %></h1>
    <a href="/admin/team">&larr; Back to Team</a>
  </div>

  <% if (errors && errors.length) { %>
    <div class="admin-alert admin-alert--error">
      <ul style="margin:0; padding-left:20px;">
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form method="post" action="<%= member ? `/admin/team/${member.id}` : '/admin/team' %>" enctype="multipart/form-data" class="admin-form">
    <div class="form-row">
      <div class="form-group">
        <label for="name">Name *</label>
        <input type="text" id="name" name="name" required value="<%= member ? member.name : '' %>" />
      </div>
      <div class="form-group">
        <label for="roleTitle">Role / Title</label>
        <input type="text" id="roleTitle" name="roleTitle" value="<%= member && member.role_title ? member.role_title : '' %>" />
      </div>
    </div>

    <div class="form-group">
      <label for="bio">Bio (optional)</label>
      <textarea id="bio" name="bio" rows="4"><%= member ? member.bio || '' : '' %></textarea>
    </div>

    <div class="form-group">
      <label for="sortOrder">Display Order</label>
      <input type="number" id="sortOrder" name="sortOrder" value="<%= member ? member.sort_order : 0 %>" />
    </div>

    <div class="form-group">
      <label for="photo">Photo (optional)</label>
      <input type="file" id="photo" name="photo" accept="image/jpeg,image/png,image/webp" />
      <% if (member && member.photo_path) { %>
        <div class="admin-image-grid" style="margin-top:12px;">
          <div class="admin-image-card"><img src="<%= member.photo_path %>" alt="" /></div>
        </div>
      <% } %>
    </div>

    <div class="form-group admin-checkbox-row">
      <input type="checkbox" id="isPublished" name="isPublished" <%= member && member.is_published ? 'checked' : '' %> />
      <label for="isPublished" style="margin:0;">Published (visible on the public site)</label>
    </div>

    <button type="submit" class="btn btn-primary"><%= member ? 'Save Changes' : 'Create Team Member' %></button>
  </form>

<%- include('../partials/shell-close') %>
</body>
</html>
