<!doctype html>
<html lang="en">
<head>
<%- include('../partials/head', { title: 'Team' }) %>
</head>
<body>
<%- include('../partials/shell-open', { active: 'team' }) %>

  <div class="admin-page-header">
    <h1>Team</h1>
    <a href="/admin/team/new" class="btn btn-primary">+ Add Team Member</a>
  </div>

  <% if (members.length === 0) { %>
    <div class="content-required-block">No team members yet. Add the first one to get started.</div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Role</th>
          <th>Order</th>
          <th>Published</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% members.forEach(function(m) { %>
          <tr>
            <td><%= m.name %></td>
            <td><%= m.role_title || '—' %></td>
            <td><%= m.sort_order %></td>
            <td><span class="admin-badge admin-badge--<%= m.is_published ? 'live' : 'draft' %>"><%= m.is_published ? 'Published' : 'Draft' %></span></td>
            <td class="admin-table-actions">
              <a href="/admin/team/<%= m.id %>/edit">Edit</a>
              <form method="post" action="/admin/team/<%= m.id %>/delete" onsubmit="return confirm('Delete this team member permanently?');" style="display:inline;">
                <button type="submit" class="admin-link-btn">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>

<%- include('../partials/shell-close') %>
</body>
</html>
