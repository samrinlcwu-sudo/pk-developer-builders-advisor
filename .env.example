# Copy this file to .env and fill in real values. Never commit .env.

# Server
PORT=5588
NODE_ENV=development

# Session
SESSION_SECRET=change-me-to-a-long-random-string

# First admin user (used only by `npm run create-admin`)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP notification settings (leave blank to disable email notifications —
# leads still persist to the database either way)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_TO_EMAIL=

# Public site origin(s) allowed by CORS for any cross-origin API access
PUBLIC_SITE_ORIGIN=http://localhost:5588

# AI chat widget (leave blank to disable — the widget shows a
# "not set up yet" message instead of erroring). Get a key at
# console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
